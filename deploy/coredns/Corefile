# Caching DNS sidecar for Prebid Server. Go's resolver does not cache, so every new outbound
# connection (bidder endpoints, prebid cache, currency rates) costs a lookup; this sidecar answers
# repeats from memory and prefetches popular names before they expire.
.:53 {
    errors
    log . "{remote} {type} {name} {rcode} {duration}"
    cache 300 {
        success 4096 300
        denial 1024 60
        prefetch 5 1m 10%
    }
    forward . 1.1.1.1 8.8.8.8 {
        policy round_robin
        health_check 10s
    }
    prometheus 0.0.0.0:9153
    reload
}
